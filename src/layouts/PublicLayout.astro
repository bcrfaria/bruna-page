---
import Icone from '../components/Icone.astro';
import { site, whatsappComOrigem } from '../config';
import '../styles/public.css';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  eyebrow?: string;
  type?: 'website' | 'article';
  publishedDate?: Date;
  updatedDate?: Date;
  ogImage?: string;
}

const {
  title,
  description,
  canonicalPath,
  type = 'website',
  publishedDate,
  updatedDate,
  ogImage = '/img/og-bruna-faria.png',
} = Astro.props;

const canonical = new URL(canonicalPath, site.url).href;
const socialImage = new URL(ogImage, site.url).href;
const whatsappUrl = whatsappComOrigem(`pela página “${title.replace(/ \|.*$/, '')}”`);

const jsonLd = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'Article',
      headline: title.replace(/ \|.*$/, ''),
      description,
      image: socialImage,
      datePublished: publishedDate?.toISOString(),
      dateModified: (updatedDate ?? publishedDate)?.toISOString(),
      author: {
        '@type': 'Person',
        name: site.nome,
        url: site.url,
      },
      publisher: {
        '@type': 'Person',
        name: site.nome,
        url: site.url,
      },
      mainEntityOfPage: canonical,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebPage',
      name: title,
      description,
      url: canonical,
      isPartOf: {
        '@type': 'WebSite',
        name: `${site.nome} · Psicologia`,
        url: site.url,
      },
    };
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/brand/simbolo-principal-bruna-faria-transparente.png" type="image/png" />

    <meta property="og:type" content={type} />
    <meta property="og:site_name" content={`${site.nome} · Psicologia`} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Bruna Faria · Psicologia" />
    <meta property="og:locale" content="pt_BR" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />

    {type === 'article' && publishedDate && (
      <meta property="article:published_time" content={publishedDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@500;600&display=swap"
      rel="stylesheet"
    />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body>
    <a href="#conteudo" class="skip">Pular para o conteúdo</a>

    <nav class="topo" aria-label="Navegação principal">
      <div class="wrap topo-inner">
        <a class="marca" href="/" aria-label="Página inicial de Bruna Faria">
          <img src="/brand/simbolo-principal-bruna-faria-transparente.png" width="28" height="34" alt="" />
          <span>
            <strong>Bruna Faria</strong>
            <small>Psicóloga · {site.crp}</small>
          </span>
        </a>
        <div class="menu">
          <a href="/#sobre">Sobre</a>
          <a href="/conteudos/">Conteúdos</a>
          <a href="/#faq">Dúvidas</a>
          <a href="/contato/">Contato</a>
          <a class="menu-cta" href={whatsappUrl} target="_blank" rel="noopener">Conversar</a>
        </div>
      </div>
    </nav>

    <main id="conteudo">
      <slot />
    </main>

    <footer class="rodape">
      <div class="wrap rodape-grid">
        <div class="rodape-marca">
          <img src="/brand/simbolo-principal-bruna-faria-transparente.png" width="38" height="46" alt="" />
          <div>
            <p class="nome">{site.nome}</p>
            <p>Psicóloga · {site.crp}</p>
          </div>
        </div>
        <nav aria-label="Canais profissionais">
          <a href={whatsappUrl} target="_blank" rel="noopener"><Icone nome="whatsapp" /> WhatsApp</a>
          <a href="/conteudos/">Conteúdos</a>
          <a href="/contato/">Contato</a>
        </nav>
        <p class="aviso-crise">Este site não oferece atendimento de urgência. Em situação de crise ou risco imediato, procure um serviço de emergência da sua região.</p>
      </div>
    </footer>
  </body>
</html>
