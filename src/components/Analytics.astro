---
import { analyticsMeasurementId } from '../config';
---

<script is:inline define:vars={{ analyticsMeasurementId }}>
  (() => {
  const analyticsConsentKey = 'bruna-analytics-consent';
  const loadAnalytics = () => {
    if (window.__brunaAnalyticsLoaded || !analyticsMeasurementId) return;
    window.__brunaAnalyticsLoaded = true;
    window.dataLayer = window.dataLayer || [];
    window.gtag = function () { window.dataLayer.push(arguments); };
    window.gtag('js', new Date());
    window.gtag('config', analyticsMeasurementId, {
      allow_google_signals: false,
      allow_ad_personalization_signals: false,
      page_location: window.location.origin + window.location.pathname,
      page_referrer: document.referrer ? new URL(document.referrer).origin : '',
    });
    const script = document.createElement('script');
    script.async = true;
    script.src = `https://www.googletagmanager.com/gtag/js?id=${analyticsMeasurementId}`;
    document.head.appendChild(script);
  };

  const track = (name, params = {}) => {
    if (window.__brunaAnalyticsLoaded && window.gtag) window.gtag('event', name, params);
  };

  if (window.localStorage.getItem(analyticsConsentKey) === 'accepted') loadAnalytics();

  document.addEventListener('DOMContentLoaded', () => {
    document.querySelectorAll('a[href*="wa.me"], a[href^="mailto:"]').forEach((link) => {
      link.addEventListener('click', () => track('contact_click', {
        method: link.href.startsWith('mailto:') ? 'email' : 'whatsapp',
        page_path: window.location.pathname,
      }));
    });
    document.querySelectorAll('a[href="/contato/"]').forEach((link) => {
      link.addEventListener('click', () => track('navigation_to_contact', {
        destination: link.getAttribute('href'),
        page_path: window.location.pathname,
      }));
    });
  });
  })();
</script>

<aside class="analytics-consent" data-analytics-consent hidden aria-labelledby="analytics-consent-title">
  <div class="analytics-consent-copy">
    <p id="analytics-consent-title" class="analytics-consent-title">Você aceita cookies de medição?</p>
    <p>Usamos esses cookies para entender como o site é utilizado.</p>
  </div>
  <div class="analytics-consent-actions">
    <button type="button" data-analytics-accept>Aceitar</button>
    <button type="button" data-analytics-reject>Não aceitar</button>
  </div>
  <details class="analytics-consent-details">
    <summary>Saiba mais sobre privacidade</summary>
    <p>Se você aceitar, o Google Analytics poderá registrar páginas visitadas e interações no site usando cookies. Se não aceitar, essa medição não será ativada. A escolha fica salva neste navegador.</p>
  </details>
</aside>

<script is:inline>
  (() => {
  const analyticsConsentKey = 'bruna-analytics-consent';
  const consentBanner = document.querySelector('[data-analytics-consent]');
  const savedConsent = window.localStorage.getItem(analyticsConsentKey);
  if (!savedConsent && consentBanner) consentBanner.hidden = false;

  document.querySelector('[data-analytics-accept]')?.addEventListener('click', () => {
    window.localStorage.setItem(analyticsConsentKey, 'accepted');
    consentBanner.hidden = true;
    window.location.reload();
  });
  document.querySelector('[data-analytics-reject]')?.addEventListener('click', () => {
    window.localStorage.setItem(analyticsConsentKey, 'rejected');
    consentBanner.hidden = true;
  });
  })();
</script>

<style is:global>
.analytics-consent {
  position: fixed;
  z-index: 30;
  right: 6rem;
  bottom: max(1rem, env(safe-area-inset-bottom));
  left: 1rem;
  display: grid;
  grid-template-columns: 1fr auto;
  gap: .65rem 1.25rem;
  max-width: 48rem;
  max-height: calc(100dvh - 7rem);
  overflow-y: auto;
  padding: 1rem 1.15rem;
  border: 1px solid var(--linha, #dedbd3);
  border-radius: 1rem;
  background: var(--papel, #fdfbf7);
  box-shadow: 0 1rem 3rem rgb(34 42 37 / 14%);
}

.analytics-consent[hidden] { display: none; }
.analytics-consent p { margin: 0; color: var(--tinta, #2e2a26); font-size: .88rem; line-height: 1.5; }
.analytics-consent .analytics-consent-title { margin-bottom: .2rem; font-size: .95rem; font-weight: 600; }
.analytics-consent-actions { display: flex; align-items: center; flex-wrap: wrap; gap: .65rem; }
.analytics-consent-actions button {
  min-height: 44px;
  padding: .55rem .8rem;
  border: 1px solid var(--verde-escuro, #34463b);
  border-radius: 999px;
  color: var(--verde-escuro, #34463b);
  background: transparent;
  font: inherit;
  cursor: pointer;
}
.analytics-consent-actions button:hover { background: var(--papel-fundo, #f5f1e8); }
.analytics-consent-actions button:focus-visible,
.analytics-consent-details summary:focus-visible {
  outline: 2px solid var(--tinta, #2e2a26);
  outline-offset: 3px;
}
.analytics-consent-details { grid-column: 1 / -1; }
.analytics-consent-details summary { width: fit-content; color: var(--tinta, #2e2a26); font-size: .8rem; text-decoration: underline; text-underline-offset: .2em; cursor: pointer; }
.analytics-consent-details p { margin-top: .65rem; }

@media (max-width: 640px) {
  .analytics-consent { grid-template-columns: 1fr; right: .75rem; left: .75rem; bottom: max(5.25rem, calc(env(safe-area-inset-bottom) + 4.25rem)); padding: .9rem 1rem; }
}

</style>
