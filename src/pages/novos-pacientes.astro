---
import { site } from '../config';

const formUrl = 'https://docs.google.com/forms/d/e/1FAIpQLSccnVX61qv0qA2jZGOGJV7p3Hq9XR490hgGi0OlxKBqF1TQaw/viewform';
const embeddedFormUrl = `${formUrl}?embedded=true`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow, noarchive" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <meta name="theme-color" content="#f5f1e8" />
    <title>Cadastro para abertura de prontuário | {site.nome}</title>
    <meta name="description" content="Formulário de cadastro para novos pacientes de psicoterapia online." />
    <link rel="icon" href="/brand/simbolo-principal-bruna-faria-transparente.png" type="image/png" />
    <link rel="canonical" href="https://brunafaria.com.br/novos-pacientes/" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@400;500&display=swap" rel="stylesheet" />
  </head>

  <body>
    <a href="#formulario" class="skip">Pular para o formulário</a>

    <header class="site-header">
      <a class="brand" href="/" aria-label="Bruna Faria Psicologia — página inicial">
        <img src="/brand/simbolo-principal-bruna-faria-transparente.png" width="36" height="44" alt="" />
        <span class="brand-copy"><strong>{site.nome}</strong><small>Psicóloga · {site.crp}</small></span>
      </a>
      <span class="confidential-note"><span aria-hidden="true">●</span> Formulário confidencial</span>
    </header>

    <main>
      <section class="page-intro" aria-labelledby="page-title">
        <figure class="intro-art">
          <img src="/img/novos-pacientes/abstrato-identidade-cadastro.jpg" alt="Composição abstrata em verde-petróleo, terracota, âmbar e marfim" width="1400" height="757" fetchpriority="high" />
        </figure>
        <div class="intro-copy">
          <p class="eyebrow">Novos pacientes</p>
          <h1 id="page-title">Cadastro para abertura de prontuário</h1>
          <p class="intro-text">Preencha os dados abaixo com calma. As informações serão usadas exclusivamente para a organização do seu atendimento psicológico.</p>
          <ul class="intro-details" aria-label="Informações sobre o formulário">
            <li><span aria-hidden="true">◷</span> Cerca de 6 minutos</li>
            <li><span aria-hidden="true">✓</span> Respostas enviadas diretamente ao Google Forms</li>
          </ul>
        </div>
      </section>

      <section class="form-section" id="formulario" aria-label="Formulário de abertura de prontuário">
        <div class="form-frame">
          <iframe
            src={embeddedFormUrl}
            title="Formulário de abertura de prontuário psicológico"
            loading="eager"
            referrerpolicy="strict-origin-when-cross-origin"
          >Carregando formulário…</iframe>
        </div>

        <p class="form-fallback">O formulário não apareceu? <a href={formUrl} target="_blank" rel="noopener noreferrer">Abrir diretamente no Google Forms</a>.</p>
      </section>
    </main>

    <footer class="site-footer">
      <span>Psic. Bruna Caroline Rodrigues Faria · {site.crp}</span>
      <a href={`mailto:${site.email}`}>{site.email}</a>
    </footer>
  </body>
</html>

<style>
  :root {
    color-scheme: only light;
    --ink: #26312c;
    --muted: #68736c;
    --paper: #f5f1e8;
    --surface: #ffffff;
    --line: #dcded8;
    --petrol: #36594d;
    --terracotta: #b65f3d;
    font-family: Inter, Arial, sans-serif;
    color: var(--ink);
    background: var(--paper);
  }

  * { box-sizing: border-box; }
  html { background: var(--paper); scroll-behavior: smooth; }

  body {
    min-width: 320px;
    margin: 0;
    color: var(--ink);
    background: radial-gradient(circle at 92% 3%, rgba(201, 139, 58, .12), transparent 26rem), var(--paper);
  }

  a { color: inherit; }

  .skip {
    position: absolute;
    z-index: 10;
    top: 8px;
    left: 8px;
    padding: 10px 14px;
    color: #ffffff;
    background: var(--petrol);
    transform: translateY(-160%);
  }

  .skip:focus { transform: translateY(0); }

  .site-header,
  .site-footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    width: 100%;
    padding: 18px max(24px, calc((100% - 1120px) / 2));
    border-color: var(--line);
    background: rgba(255, 255, 255, .84);
  }

  .site-header { border-bottom: 1px solid var(--line); }

  .brand { display: inline-flex; align-items: center; gap: 12px; text-decoration: none; }
  .brand > img { width: 36px; height: 44px; object-fit: contain; }
  .brand-copy strong, .brand-copy small { display: block; }
  .brand-copy strong { font-family: Lora, Georgia, serif; font-size: 1.04rem; font-weight: 500; }
  .brand-copy small { margin-top: 2px; color: var(--muted); font-size: .73rem; }
  .confidential-note { color: #59675f; font-size: .78rem; }
  .confidential-note span { margin-right: 6px; color: #4f8062; }

  main { padding: 0 24px 64px; }

  .page-intro {
    display: grid;
    grid-template-columns: minmax(0, .92fr) minmax(0, 1.08fr);
    align-items: center;
    gap: clamp(34px, 6vw, 72px);
    width: min(100%, 1040px);
    margin: 0 auto;
    padding: 62px 0 48px;
  }

  .intro-art {
    min-height: 310px;
    margin: 0;
    overflow: hidden;
    border-radius: 10px 112px 10px 10px;
    background: #ebe0cf;
    box-shadow: 0 18px 40px rgba(44, 57, 49, .14);
  }

  .intro-art img { display: block; width: 100%; height: 100%; min-height: 310px; object-fit: cover; }

  .eyebrow {
    margin: 0;
    color: var(--terracotta);
    font-size: .76rem;
    font-weight: 500;
    letter-spacing: .14em;
    text-transform: uppercase;
  }

  h1, h2 { font-family: Lora, Georgia, serif; font-weight: 400; text-wrap: balance; }
  h1 { max-width: 600px; margin: 15px 0 0; font-size: clamp(2.35rem, 5vw, 4.25rem); line-height: 1.02; }
  h2 { margin: 11px 0 0; font-size: clamp(1.8rem, 3vw, 2.45rem); line-height: 1.1; }

  .intro-text { max-width: 600px; margin: 22px 0 0; color: var(--muted); font-size: 1rem; line-height: 1.7; }
  .intro-details { display: grid; gap: 10px; margin: 24px 0 0; padding: 0; color: #536158; font-size: .84rem; list-style: none; }
  .intro-details span { display: inline-block; width: 22px; color: var(--terracotta); font-weight: 500; }

  .form-section {
    width: min(100%, 820px);
    margin: 0 auto;
    padding: 0;
  }

  .form-frame { width: 100%; overflow: hidden; border-radius: 12px; background: var(--paper); }
  .form-frame iframe { display: block; width: 100%; height: 4200px; border: 0; background: var(--paper); }
  .form-fallback { margin: 18px 0 0; color: var(--muted); font-size: .8rem; line-height: 1.55; text-align: center; }
  .form-fallback a { color: var(--petrol); font-weight: 500; text-underline-offset: 3px; }

  .site-footer { align-items: flex-start; border-top: 1px solid var(--line); color: var(--muted); font-size: .76rem; }
  .site-footer a { text-underline-offset: 3px; }

  @media (max-width: 720px) {
    .site-header, .site-footer { padding: 16px 18px; }
    .confidential-note { display: none; }
    main { padding: 0 0 42px; }
    .page-intro { display: block; padding: 34px 18px 26px; }
    .intro-art { min-height: 190px; margin-bottom: 30px; border-radius: 8px 68px 8px 8px; }
    .intro-art img { min-height: 190px; }
    h1 { font-size: clamp(2.15rem, 11vw, 3.2rem); }
    .form-frame { border-radius: 0; }
    .form-frame iframe { height: 4800px; }
    .form-fallback { padding-inline: 18px; }
    .site-footer { flex-direction: column; gap: 8px; }
  }

  @media (prefers-reduced-motion: reduce) {
    html { scroll-behavior: auto; }
  }
</style>
