---
import { site, whatsappUrl } from '../config';
import Icone from '../components/Icone.astro';

const instagramUrl = `https://instagram.com/${site.instagram}`;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const url = (caminho) => `${base}${caminho}`;
const canonical = `${site.url}/cartao/`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Cartão virtual | {site.nome}</title>
    <meta
      name="description"
      content="Cartão virtual de Bruna Faria, psicóloga com atendimento online para adultos."
    />
    <link rel="icon" href={url('/brand/simbolo-principal-bruna-faria-transparente.png')} type="image/png" />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="profile" />
    <meta property="og:title" content={`Cartão virtual | ${site.nome}`} />
    <meta
      property="og:description"
      content="Psicoterapia online para adultos. Acesse contatos, site e redes profissionais."
    />
    <meta property="og:locale" content="pt_BR" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Lora:wght@500;600&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <main class="pagina" aria-label="Cartão virtual de Bruna Faria">
      <section class="cartao">
        <img class="simbolo" src={url('/brand/simbolo-principal-bruna-faria-transparente.png')} width="76" height="93" alt="" />

        <p class="eyebrow">Psicóloga · {site.crp}</p>
        <h1>{site.nome}</h1>
        <p class="resumo">
          Psicoterapia online para adultos no Brasil e no exterior, com escuta acolhedora,
          afirmativa e tecnicamente fundamentada.
        </p>

        <nav class="acoes" aria-label="Canais principais">
          <a class="btn principal" href={whatsappUrl} target="_blank" rel="noopener">
            <Icone nome="whatsapp" /> Falar no WhatsApp
          </a>
          <a class="btn" href={url('/')} >
            Conhecer o site
          </a>
          <a class="btn" href={url('/pdf/cartao-virtual-bruna-faria.pdf')} target="_blank" rel="noopener">
            Salvar PDF clicável
          </a>
          <a class="btn" href={url('/pdf/cartao-visita-bruna-faria-impressao.pdf')} target="_blank" rel="noopener">
            Baixar cartão para impressão
          </a>
          <a class="btn" href={instagramUrl} target="_blank" rel="noopener">
            <Icone nome="instagram" /> @{site.instagram}
          </a>
          {site.doctoralia && (
            <a class="btn" href={site.doctoralia} target="_blank" rel="noopener">
              <Icone nome="doctoralia" /> Doctoralia
            </a>
          )}
        </nav>

        <div class="contatos">
          <a href={`tel:+${site.whatsapp}`}>{site.telefoneFormatado}</a>
          {site.email && <a href={`mailto:${site.email}`}>{site.email}</a>}
          <span>brunafaria.com.br</span>
        </div>
      </section>
    </main>

    <style>
      :root {
        --papel: #fdfbf7;
        --papel-fundo: #f7f3ec;
        --tinta: #2e2a26;
        --tinta-suave: #5c554d;
        --linha: #e4ddd0;
        --verde: #6b7f6e;
        --verde-escuro: #55684f;
        --terracota: #a6634b;
        --vinho: #744b4b;
      }

      * { box-sizing: border-box; }

      body {
        margin: 0;
        min-height: 100vh;
        background:
          linear-gradient(180deg, rgba(116, 75, 75, .08), transparent 34rem),
          var(--papel-fundo);
        color: var(--tinta);
        font-family: Inter, ui-sans-serif, system-ui, sans-serif;
        font-weight: 400;
        line-height: 1.65;
        -webkit-font-smoothing: antialiased;
      }

      .pagina {
        min-height: 100vh;
        display: grid;
        place-items: center;
        padding: clamp(1.25rem, 5vw, 3rem);
      }

      .cartao {
        width: min(100%, 28rem);
        padding: clamp(2rem, 7vw, 3rem);
        background: var(--papel);
        border: 1px solid var(--linha);
        border-radius: 12px;
        box-shadow: 0 24px 70px rgba(46, 42, 38, .12);
      }

      .simbolo {
        display: block;
        width: 4.75rem;
        height: auto;
        margin-bottom: 1.75rem;
      }

      .eyebrow {
        margin: 0 0 .85rem;
        color: var(--terracota);
        font-size: .75rem;
        font-weight: 500;
        letter-spacing: .14em;
        text-transform: uppercase;
      }

      h1 {
        margin: 0;
        font-family: Lora, ui-serif, Georgia, serif;
        font-size: clamp(2.3rem, 12vw, 3.7rem);
        font-weight: 500;
        letter-spacing: -.015em;
        line-height: 1;
      }

      .resumo {
        margin: 1.15rem 0 0;
        color: var(--tinta-suave);
        font-size: 1rem;
      }

      .acoes {
        display: grid;
        gap: .75rem;
        margin-top: 2rem;
      }

      .btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: .55rem;
        min-height: 3.1rem;
        padding: .75rem 1rem;
        border: 1px solid var(--linha);
        border-radius: 999px;
        color: var(--verde-escuro);
        background: transparent;
        font-size: .95rem;
        font-weight: 400;
        text-decoration: none;
        transition: background .2s ease, border-color .2s ease, color .2s ease;
      }

      .btn:hover {
        border-color: var(--verde);
        background: #fff;
      }

      .btn.principal {
        border-color: var(--verde);
        background: var(--verde);
        color: #fff;
      }

      .btn.principal:hover {
        border-color: var(--verde-escuro);
        background: var(--verde-escuro);
      }

      .contatos {
        display: grid;
        gap: .2rem;
        margin-top: 1.7rem;
        padding-top: 1.35rem;
        border-top: 1px solid var(--linha);
        color: var(--tinta-suave);
        font-size: .82rem;
        text-align: center;
      }

      .contatos a {
        color: inherit;
        text-decoration: none;
      }

      .contatos a:hover {
        color: var(--verde-escuro);
        text-decoration: underline;
        text-underline-offset: .25rem;
      }

      :where(a):focus-visible {
        outline: 2px solid var(--verde);
        outline-offset: 3px;
      }
    </style>
  </body>
</html>
