---
import type { CollectionEntry } from 'astro:content';
import { getCollection, render } from 'astro:content';
import PublicLayout from '../../layouts/PublicLayout.astro';
import Icone from '../../components/Icone.astro';
import { whatsappComOrigem } from '../../config';

export async function getStaticPaths() {
  const artigos = await getCollection('artigos', ({ data }) => !data.draft && data.publishedDate <= new Date());
  return artigos.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

interface Props { post: CollectionEntry<'artigos'>; }
const { post } = Astro.props;
const { Content } = await render(post);
const title = `${post.data.title} | Bruna Faria`;
const whatsappUrl = whatsappComOrigem(`pelo texto “${post.data.title}”`);
const formatarData = (data: Date) => new Intl.DateTimeFormat('pt-BR', {
  day: '2-digit', month: 'long', year: 'numeric', timeZone: 'UTC',
}).format(data);
---

<PublicLayout
  title={title}
  description={post.data.description}
  canonicalPath={`/conteudos/${post.id}/`}
  type="article"
  publishedDate={post.data.publishedDate}
  updatedDate={post.data.updatedDate}
  ogImage={post.data.ogImage}
>
  <header class="artigo-cabecalho">
    <div class="wrap">
      <ul class="trilha"><li>{post.data.tema}</li></ul>
      <h1>{post.data.title}</h1>
      <p class="lead">{post.data.description}</p>
      <p class="artigo-meta">
        Por Bruna Faria · Psicóloga · CRP 08/34202 ·
        <time datetime={post.data.publishedDate.toISOString()}>{formatarData(post.data.publishedDate)}</time>
        {post.data.updatedDate && <> · Atualizado em {formatarData(post.data.updatedDate)}</>}
      </p>
    </div>
  </header>

  <article class="artigo-corpo">
    <Content />
  </article>

  <section class="convite">
    <div class="wrap convite-grid">
      <div>
        <p class="eyebrow">Um convite, sem pressão</p>
        <h2>Você não precisa chegar com tudo organizado.</h2>
        <p>Se este texto se aproxima de algo que você está vivendo e quiser saber como funciona a psicoterapia, o primeiro contato pode ser simples.</p>
      </div>
      <div class="acoes">
        <a class="btn" href={whatsappUrl} target="_blank" rel="noopener"><Icone nome="whatsapp" /> Conversar com a Bruna</a>
        <a class="btn secundario" href="/conteudos/">Ver outros textos</a>
      </div>
    </div>
  </section>
</PublicLayout>
